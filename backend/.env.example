PROJECT_NAME="Smart Attendance Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite+aiosqlite:///./smart_attendance.db"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

FACE_SIMILARITY_THRESHOLD=0.65
FACE_MIN_SIZE=100
FACE_LAPLACIAN_VAR_THRESHOLD=80.0
LIVENESS_EAR_THRESHOLD=0.20
LIVENESS_YAW_THRESHOLD=15.0
LIVENESS_TIMEOUT_SECONDS=20
